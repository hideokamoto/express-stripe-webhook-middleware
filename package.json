{
  "name": "express-stripe-webhook-middleware",
  "version": "1.0.0",
  "description": "Express middleware for Stripe webhook signature verification",
  "license": "MIT",
  "author": "Hidetaka Okamoto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hideokamoto/express-stripe-webhook-middleware.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test",
    "release": "np"
  },
  "keywords": [
    "stripe",
    "webhook",
    "express",
    "middleware",
    "signature",
    "verification"
  ],
  "dependencies": {
    "body-parser": "^1.20.3"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "stripe": "^14.0.0 || ^15.0.0 || ^16.0.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/body-parser": "^1.19.5",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "express": "^4.21.2",
    "np": "^10.2.0",
    "stripe": "^17.5.0",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "np": {
    "yarn": false,
    "contents": ".",
    "tests": true,
    "2fa": true
  },
  "packageManager": "pnpm@10.34.9"
}
